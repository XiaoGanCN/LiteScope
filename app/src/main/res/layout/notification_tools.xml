<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification panel (ideas/ "New notification center idea VERSION 2").
  Every coloured surface is a tintable solid layer under the content, so RemoteViews can recolour it
  from the accent/background theme while keeping the rounded shapes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="3dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/notif_panel_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_notif_panel_solid"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/scope_spectrum_bg"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_circle_solid"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/scope_spectrum"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tool_spectrum"
                    android:contentDescription="@string/tool_spectrum" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/scope_waterfall_bg"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_circle_solid"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/scope_waterfall"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tool_waterfall"
                    android:contentDescription="@string/tool_waterfall" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/scope_waveform_bg"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_circle_solid"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/scope_waveform"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tool_wave"
                    android:contentDescription="@string/tool_waveform" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/scope_vector_bg"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_circle_solid"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/scope_vector"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tool_vector"
                    android:contentDescription="@string/tool_vector" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/scope_meters_bg"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_circle_solid"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/scope_meters"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tool_meters"
                    android:contentDescription="@string/tool_meters" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/action_record_bg"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_circle_solid"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/action_record"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_record"
                    android:contentDescription="@string/notif_action_record" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <Chronometer
                    android:id="@+id/notif_rec_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="monospace"
                    android:textSize="15sp"
                    android:textColor="#FFE6EDF3"
                    android:shadowColor="#66FFFFFF"
                    android:shadowRadius="9"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:singleLine="true"
                    android:text="" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="22dp">

                <ImageView
                    android:id="@+id/action_layout"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_grid"
                    android:contentDescription="@string/notif_action_reset_layout" />

                <ImageView
                    android:id="@+id/action_settings"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/win_settings" />

                <ImageView
                    android:id="@+id/action_stop"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_power"
                    android:contentDescription="@string/notif_action_stop" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="14dp">

            <ImageView
                android:id="@+id/notif_info_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_notif_pill_solid"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/notif_info_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_notif_pill_stroke"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/notif_mini"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mini_scope"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/notif_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="10sp"
                    android:textColor="#FF8A97A5"
                    android:shadowColor="#4DFFFFFF"
                    android:shadowRadius="7"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
