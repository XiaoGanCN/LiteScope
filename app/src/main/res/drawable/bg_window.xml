<?xml version="1.0" encoding="utf-8"?>
<!-- Outline only: the scope view paints its own (opacity-aware) background, so a filled window
     background would add a black tint at low opacity. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="1dp" android:color="#FF35505F" />
    <corners android:radius="12dp" />
</shape>
